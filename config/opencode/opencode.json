  "provider": {
    "ollama": {
      "models": {},
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
