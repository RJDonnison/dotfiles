{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-4.7"
    },
    "plan": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.2"
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest",
    "envsitter-guard@latest"
  ],
  "experimental": {
    "quotaToast": {
      "enableToast": false
    }
  },
  "provider": {
    "zai-coding-plan": {
      "options": {
        "headers": {
          "sleev-provider": "zai-coding-plan",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "copilot": {}
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-e71a3014-6a28-44f7-90e8-900c289c91c8"
      }
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx"]
    },
    "rustfmt": {
      "command": ["rustfmt"],
      "extensions": [".rs"]
    },
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs"]
    }
  },
  "compaction": {
    "prune": false
  }
}
