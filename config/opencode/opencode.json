{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-plus"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/qwen3.7-max"
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "@slkiser/opencode-quota",
    "@mohak34/opencode-notifier@latest",
    "envsitter-guard@latest"
  ],
  "experimental": {
    "quotaToast": {
      "enableToast": false
    }
  },
  "provider": {
    "copilot": {
      "options": {
        "headers": {
          "sleev-provider": "copilot",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "opencode-go": {
      "options": {
        "headers": {
          "sleev-provider": "opencode-go",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "google": {
      "options": {
        "headers": {
          "sleev-provider": "google",
          "sleev-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/usr/bin/chromium"
      ],
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-e71a3014-6a28-44f7-90e8-900c289c91c8"
      }
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".jsx", ".tsx"]
    },
    "rustfmt": {
      "command": ["rustfmt"],
      "extensions": [".rs"]
    },
    "dotnet-format": {
      "command": ["dotnet", "format", "--include", "$FILE"],
      "extensions": [".cs"]
    }
  },
  "compaction": {
    "prune": false
  }
}
